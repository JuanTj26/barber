{
  "buildCommand": "",
  "installCommand": "",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/(.*\\.js)", "dest": "/js/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
